{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "delete_configuration",
    "title": "Data deletion configuration",
    "description": "The configuration for the data deletion program",
    "type": "object",
    "properties": {
        "main_database": {
            "description": "Connection details: access to database tables describing photovoltaic installations (detected, declared, or the links between the two)",
            "type": "object",
            "properties": {
                "host": {
                    "description": "Database hostname",
                    "type": "string",
                    "anyOf": [
                        {
                            "format": "hostname"
                        },
                        {
                            "format": "ipv4"
                        },
                        {
                            "format": "ipv6"
                        }
                    ]
                },
                "port": {
                    "description": "Database host's port",
                    "type": "integer"
                },
                "name": {
                    "description": "Database's name on the host server",
                    "type": "string"
                },
                "user": {
                    "description": "User's name",
                    "type": "string"
                },
                "password": {
                    "description": "User's password",
                    "type": "string"
                },
                "schema": {
                    "description": "Name of the schema",
                    "type": "string"
                },
                "tables": {
                    "description": "Name of the tables",
                    "type": "object",
                    "properties": {
                        "detections": {
                            "description": "Table: Detected photovoltaic installations",
                            "type": "string"
                        },
                        "declarations": {
                            "description": "Table: Declared photovoltaic installations",
                            "type": "string"
                        },
                        "links": {
                            "description": "Table: Links pairing entries from the other tables, when describing a same installation",
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "detections",
                        "declarations",
                        "links"
                    ]
                }
            },
            "additionalProperties": false,
            "required": [
                "host",
                "port",
                "name",
                "user",
                "password",
                "schema",
                "tables"
            ]
        },
        "to_delete": {
            "description": "Identifiers of objects to delete from the database",
            "type": "object",
            "properties": {
                "declarations": {
                    "description": "Declarations list",
                    "type": "array",
                    "items": {
                        "description": "declaration's FID",
                        "type": "number"
                    },
                    "uniqueItems": true
                },
                "detections": {
                    "description": "Detections list",
                    "type": "array",
                    "items": {
                        "description": "detection's FID",
                        "type": "number"
                    },
                    "uniqueItems": true
                },
                "pairs": {
                    "description": "Detection-declaration pairs list",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "declaration": {
                                "description": "declaration's FID",
                                "type": "number"
                            },
                            "detection": {
                                "description": "detection's FID",
                                "type": "number"
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "declaration",
                            "detection"
                        ]
                    },
                    "uniqueItems": true
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false,
    "required": [
        "main_database"
    ]
}
